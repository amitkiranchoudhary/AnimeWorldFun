# Copy to .env.local for local development, and add the same keys in your
# hosting provider's environment variables (e.g. Vercel → Settings → Environment Variables).
#
# Easiest way to fill the owner keys:
#   node scripts/set-owner-password.mjs "your password" you@example.com

# The only account on the site
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Signs the owner's login cookie; 32+ random characters
SESSION_SECRET=

# Public address of the site, used for sitemap/robots and social previews
NEXT_PUBLIC_SITE_URL=https://www.example.com
